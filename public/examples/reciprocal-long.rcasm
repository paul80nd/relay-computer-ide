; *****************************************************
;  Example of byte-by-byte long reciprocal using the
;  restoring unsigned integer division method
;
;    01 / 05            (ra = 1/5 to 4 bytes)
;  = 33 33 33 33
;
;    01 / 0e            (rb = 1/14 to 6 bytes)
;  = 12 49 24 92 49 24
;
;    01 / 2d            (rc = 1/45 to 8 bytes)
;  = 05 b0 5b 05 b0 5b 05 b0
;
;    01 / 7d            (rd = 1/125 to 10 bytes)
;  = 02 0c 49 ba 5e 35 3f 7c ed 91
;
;  Expected duration:   32m34s at default clock speed
; *****************************************************

; Perform each reciprocal in turn by calling function
; Note we use the special '§' operator to pack two 8-bit
; values into the 16-bit M register in the form M1§M2

        ldi m,5§ra         ; sa = 1/5 (4 bytes)
        ldi b,4
        jsr long_rcp

        ldi m,14§rb        ; rb = 1/14 (6 bytes)
        ldi b,6
        jsr long_rcp

        ldi m,45§rc        ; rc = 1/45 (8 bytes)
        ldi b,8
        jsr long_rcp

        ldi m,125§rd       ; rd = 1/125 (10 bytes)
        ldi b,10
        jsr long_rcp

        hlt

; Reserve values in memory (bytes are little-endian ordered)
; Values are aligned and initialised to 1s-4s for da-dd
; respectively to ease visibility in memory viewer
; @watch ra:4, rb:6, rc:8, rd:10

        !align 16
ra:     !fill 4, 0x11
        !fill 2, 0
rd:     !fill 10, 0x44
rb:     !fill 6, 0x22
        !fill 2,0
rc:     !fill 8, 0x33

; *****************************************************
;  Byte-by-byte Long Reciprocal: (M) = 1 / M1
;
;    M1: Divisor value (max 128)
;    M2: Location to store result (zero page)
;     B: Number of bytes to calculate result to
;
;  Resulting reciprocal is big-endian and consists of
;  only the fractional part (integral is assummed 0).
;  Operates on the zero page so M2 + B must be in ZP.
;
;  Mutates ABCD, M and XY
; *****************************************************
long_rcp: {

        ; Terms
        ;   A = remainder (register A - ongoing)
        ;   Q = quotient (register D - current byte)
        ;  -V = negated divisor (register C - constant throughout)

        ; Because we'll be using XY as a general register we write the
        ; return address directly in to the jump instruction at rtn.
        ; That also means a bit of juggling to prepare our registers.
        mov c,x         ; Capture return address in CD
        mov d,y
        mov xy,m        ; Preserve M in XY
        ldi m,rtn+1     ; Set return address from CD
        str c
        ldi m,rtn+2
        str d
        mov m2,y        ; Set result location

        not d           ; Set byte counter Y = -B (counts up to zero)
        mov b,d
        inc d
        mov y,d

        mov b,x         ; Set C = -V
        not d
        mov b,d
        inc d
        mov c,d
        ldi a,1         ; A = 1
        clr m1          ; M1 = 0 (zero page)

        ; Registers are now in the following state
        ;   A = 1 = remainder with 1 'shifted' in (A)
        ;   C = Negated divisor value (-V)
        ;  M1 = 0 (zero page)
        ;  M2 = result location (zero page)
        ;   Y = Negated count of bytes still to calculate

a_loop: ; A loop building reciprocal byte-by-byte
        clr d           ; D = 0 (Q)

        ; B loop building next reciprocal byte bit-by-bit. As the remainder
        ; is always below V (at most 128) rotating it left doubles it exactly.
        ; If 2A - V is negative the quotient bit is 0 and we restore 2A from
        ; B. Otherwise the quotient bit is 1 and we keep 2A - V, which we
        ; copy into B first so that the shared restore leaves it in place.
        ; The first bit needs no shift of Q as it's still zero.
        mov b,a         ; A = 2A - V (B = 2A)
        rol
        mov b,a
        add
        bmi b_neg
        mov b,d         ; Q bit = 1
        inc d
        mov b,a         ; Keep 2A - V
b_neg:  mov a,b

b_loop: !for i in range(7) {
        mov b,d         ; Q << 1
        rol d
        mov b,a         ; A = 2A - V (B = 2A)
        rol
        mov b,a
        add
        bmi _neg
        mov b,d         ; Q bit = 1
        inc d
        mov b,a         ; Keep 2A - V
  _neg: mov a,b
}

        ; D now contains our complete byte so we'll store it in memory.
        str d

        ; We can now bump M2 to point at the next location in memory and count
        ; the byte off. Note that the 'jmp *' will be replaced by the actual
        ; return address at the beginning of this routine.
        mov b,m2        ; bump M2
        inc d
        mov m2,d
        mov b,y         ; Y++, loop until it reaches zero
        inc d
        mov y,d
        bne a_loop
rtn:    jmp *
}
