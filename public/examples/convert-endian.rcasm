; *****************************************************
;  Example of endian conversion (reverse bytes):
;
;     12 34 56 78                   (ca)
;  -> 78 56 34 12
;
;     f6 73 e9 cc 66 c0 8c          (cb)
;  -> 8c c0 66 cc e9 73 f6
;
;     32 43 f6 a6 59 b3 45 66 9c 67 (cc)
;  -> 67 9c 66 45 b3 59 a6 f6 43 32
;
;  Expected duration: 2m47s at default clock speed
; *****************************************************

; Perform each conversion in turn by calling reverse function

        ldi m,ca        ; reverse(ca) (4 bytes)
        ldi b,4
        jsr reverse

        ldi m,cb        ; reverse(cb) (7 bytes)
        ldi b,7
        jsr reverse

        ldi m,cc        ; reverse(cc) (10 bytes)
        ldi b,10
        jsr reverse

        hlt

; Initial values in memory - values will be reversed in-place
; Values are aligned to ease visibility in memory viewer
; @watch ca:4, cb:7, cc:10

        !align 16
ca:     !byte 0x12, 0x34, 0x56, 0x78
        !fill 5,0
cb:     !byte 0xf6, 0x73, 0xe9, 0xcc, 0x66, 0xc0, 0x8c
cc:     !byte 0x32, 0x43, 0xf6, 0xa6, 0x59, 0xb3, 0x45, 0x66, 0x9c, 0x67

        org 0x50

; *****************************************************
;  Byte-by-byte endian conversion (reverse bytes)
;
;   M: Location of value start
;   B: Length of value (at least 1)
;
;  Value will be converted in-place and must be within
;  single memory page.
;
;  Mutates ABCD and M
; *****************************************************
reverse: {

        ; Set up the address of the first byte (A) and the distance
        ; from it to the last byte (C = B - 1)
        mov c,b
        ldi b,-1
        add d
        mov c,d
        mov a,m2

        ; Registers are in the following state
        ;  A = low address of first byte of pair
        ;  C = distance from first to last byte of pair
        ;  M = address of first byte of pair
        ; XY = return address

        ; The last byte of the pair is always the first plus the
        ; distance so we don't need to keep a pointer to it.
loop:   mov b,a         ; D = low address of last byte of pair
        add d

        ; M is pointing at the first of the pair and D at the last.
        ; We now just need to swap them via B and D.
        ldr b
        mov m2,d
        ldr d
        str b
        mov m2,a
        str d

        ; Step A (and M) on to the next pair, which is 2 closer together.
        ; Subtracting 2 from the distance (by adding -2) sets the carry
        ; if it was at least 2, meaning there's another pair to swap.
        ; For an odd length the middle byte ends up swapped with itself
        ; which is harmless.
        mov b,a
        inc a
        mov m2,a
        ldi b,-2
        add d
        mov c,d
        bcs loop

        ; Jump to return address held in XY register
        rts
}
