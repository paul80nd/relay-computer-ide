; *****************************************************
;  Example of byte-by-byte long subtraction
;   (performed by 2s complement then long addition)
;
;    03 c3 c3 c3 c3 c3 c3 c3 c3 c3 (sa)
;  - 01 99 99 99 99 99 99 99 99 99 (sb)
;    fe 66 66 66 66 66 66 66 66 67 (~sb+1)
;  = 02 2a 2a 2a 2a 2a 2a 2a 2a 2a
;
;  - 00 c3 0c 30 c3 0c 30 c3 0c 30 (sc)
;    ff 3c f3 cf 3c f3 cf 3c f3 d0 (~sc+1)
;  = 01 67 1d f9 67 1d f9 67 1d fa
;
;  - 00 ba 2e 8b a2 e8 ba 2e 8b a2 (sd)
;    ff 45 d1 74 5d 17 45 d1 74 5e (~sd+1)
;  = 00 ac ef 6d c4 35 3f 38 92 58
;
;  Expected duration: 9m51s at default clock speed
; *****************************************************

; Perform each subtraction in turn by calling function
; Note we use the special '§' operator to pack two 8-bit
; values into the 16-bit M register in the form M1§M2

        ldi m,sb§sa     ; sa = sa - sb (10 bytes)
        ldi b,10
        jsr long_sub

        ldi m,sc§sa     ; sa = sa - sc (10 bytes)
        ldi b,10
        jsr long_sub

        ldi m,sd§sa     ; sa = sa - sd (10 bytes)
        ldi b,10
        jsr long_sub

        hlt

; Initial values in memory (bytes are little-endian ordered)
; Values are aligned to ease visibility in memory viewer
; @watch sa:10:le

        !align 16
sa:     !byte 0xC3, 0xC3, 0xC3, 0xC3, 0xC3, 0xC3, 0xC3, 0xC3, 0xC3, 0x03
        !align 16
sb:     !byte 0x99, 0x99, 0x99, 0x99, 0x99, 0x99, 0x99, 0x99, 0x99, 0x01
        !align 16
sc:     !byte 0x30, 0x0C, 0xC3, 0x30, 0x0C, 0xC3, 0x30, 0x0C, 0xC3, 0x00
        !align 16
sd:     !byte 0xA2, 0x8B, 0x2E, 0xBA, 0xE8, 0xA2, 0x8B, 0x2E, 0xBA, 0x00

; *****************************************************
;  Byte-by-byte Long Subtraction: (A) = (A) - (B)
;
;   M1: Zero page location of subtrahend value (B)
;   M2: Zero page location of minuend value (A)
;    B: Number of bytes in values (B)
;
;  Length of minuend must be the same as subtrahend.
;  Byte following minuend will mutate with carry bit.
;  Mutates A, B, C, D, M, XY
; *****************************************************
long_sub: {

        ; Prepare registers and set return address
        mov c,x         ; Capture return address in CD
        mov d,y
        mov xy,m        ; Move M params into indexer
        ldi m,rtn+1     ; Set return address from CD
        str c
        ldi m,rtn+2
        str d
        mov c,x         ; Set address of last subtrahend byte in D
        add d
        ldi b,-1
        mov c,d
        add d
        clr m1          ; clear M1 = zero page

        ; Registers are now in the following state
        ;  Y = minuend zero page address
        ;  X = subtrahend zero page address
        ;  D = zp address of last subtrahend byte
        ; M1 = zero page

        ; We subtract by adding the ones-complement of the subtrahend with
        ; a carry in to the first byte (A - B = A + ~B + 1). There's no
        ; add-with-carry so we have two copies of the loop: one that adds
        ; a carry in from the byte before (loop_c) and one without (loop).
        ; Each ends by stepping the pointers itself so that switching
        ; between them needs no extra jumps.

        ; Add the 1s complement of the subtrahend byte plus the carry in
loop_c: mov m2,x        ; C <- ~subtrahend byte + 1 (m1x)
        ldr b
        not
        mov b,a
        inc
        mov c,a
        bcs next_c      ; subtrahend byte was 0 so minuend byte unchanged and still carrying
        mov m2,y        ; B <- minuend byte (m1y)
        ldr b
        add             ; A = B + C
        str a           ; A -> minuend byte (m1y)
        bcs next_c      ; If add caused carry add it in to the next byte

        ; no carry so increment pointers and carry on without a carry in
        ixy             ; Y++ (minuend)
        mov b,x         ; X++ (subtrahend)
        inc
        mov x,a
        mov c,d         ; compare old X with last subtrahend byte
        cmp
        bne loop

        ; Jump to return address (set earlier)
rtn:    jmp *

loop:   ; Take 1s complement of subtrahend
        mov m2,x        ; B <- subtrahend byte (m1x)
        ldr b
        not             ; A = ~B
        mov c,a         ; C = A

        ; Add two bytes together
        mov m2,y        ; B <- minuend byte (m1y)
        ldr b
        add             ; A = B + C
        str a           ; A -> minuend byte (m1y)
        bcs next_c      ; If add caused carry add it in to the next byte

        ; increment x and y pointers and loop until past the last subtrahend byte
        ixy             ; Y++ (minuend)
        mov b,x         ; X++ (subtrahend)
        inc
        mov x,a
        mov c,d         ; compare old X with last subtrahend byte
        cmp
        bne loop
        jmp rtn

        ; with a carry so increment pointers and carry on with a carry in
next_c: ixy             ; Y++ (minuend)
        mov b,x         ; X++ (subtrahend)
        inc
        mov x,a
        mov c,d         ; compare old X with last subtrahend byte
        cmp
        bne loop_c

        ; A carry out of the last byte goes in to the byte following the
        ; minuend. It's possible though that could cause a carry in that
        ; byte and so on so we iterate here until no carry.
carry:  mov m2,y        ; increment minuend byte (m1y)
        ldr b
        inc
        str a
        ixy             ; Y++ (doesn't change flags)
        bcs carry       ; Go again if caused carry
        jmp rtn         ; Otherwise done
}

