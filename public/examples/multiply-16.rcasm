;**********************************************************************
; Multiply Program
;
; Multiplies two unsigned 8-bit numbers to produce a 16-bit result.
; The arguments are taken from X and Y and the result is placed in M1/M2.
;**********************************************************************

; The 16-bit result is built up in D (high byte) and A (low byte),
; working from the most significant bit of Y. For each bit the result
; is doubled and then X is added if the bit is set.
;
; Y is kept inverted (~Y) in the top of D. Each doubling shifts its next
; bit out into the carry flag while the result grows in from the bottom,
; so D holds both and no separate register or loop counter is needed.
; Inverting it means a set bit of Y gives a clear carry, so the branch
; we have (bcs, branch if carry set) can skip the add.

; First bit: the result is still zero so just shift and maybe set it to X
        mov b,y         ; D = ~Y
        not d
        clr a           ; A = 0 (low byte)
        mov b,d         ; D = D << 1, carry = inverted MSB of Y
        mov c,d
        add d
        bcs bits
        mov a,x         ; MSB of Y set so result = X

; Remaining 7 bits, unrolled so there's no loop counter to maintain
bits:   !for i in range(7) {

        mov b,a         ; A = A << 1, carry = bit moving up into D
        mov c,a
        add
        mov b,d
        bcs _cin

        mov c,d         ; D = D << 1, carry = next bit of ~Y
        add d
        bcs _next       ; Skip the add if that bit of Y is clear

  _add: mov b,a         ; A = A + X
        mov c,x
        add
        bcs _cout       ; Carry into D if needed
        jmp _next

  _cin: rol d           ; D = (D << 1) + top bit of D, carry = that bit
        bcs _next       ; Bit of Y clear: the 1 rotated in is the carry from A
        mov b,d         ; Bit of Y set: add the carry from A, then add X
        inc d
        jmp _add

 _cout: mov b,d         ; Carry from A + X into D
        inc d
 _next:
}

        mov m1,d        ; Move result into M1/M2
        mov m2,a
        hlt

; Operates on the principle of long binary multiplication. For example
; (the bits of D left of the | are the remaining bits of ~Y):
; X:   11011101  (221)
; Y: * 10110011  (179)
;    ================
;  D: 1001100|0         A: 11011101   (bit 7 of Y is 1 so add X)
;  D:  001100|01        A: 10111010   (bit 6 of Y is 0)
;  D:   01100|100       A: 01010001   (bit 5 of Y is 1 so add X)
;  D:    1100|1001      A: 01111111   (bit 4 of Y is 1 so add X)
;  D:     100|10010     A: 11111110   (bit 3 of Y is 0)
;  D:      00|100101    A: 11111100   (bit 2 of Y is 0)
;  D:       0|1001100   A: 11010101   (bit 1 of Y is 1 so add X)
;  D:         10011010  A: 10000111   (bit 0 of Y is 1 so add X)
;    =================
; M1:  10011010  M2: 10000111  (39,559)
;
; Unrolling the 7 bits saves a loop counter, which would cost at least 40
; cycles a bit (inc, bne) plus moves, as A and D are both in use.
